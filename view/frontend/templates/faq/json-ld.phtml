<?php
/**
 * FAQPage JSON-LD output template (rendered late, end of body).
 *
 * Cache safety: fully cacheable as part of the page. No cacheable="false".
 *
 * @var \MageOS\Seo\Block\FaqJsonLd $block
 */

$json = $block->getJsonLd();
if ($json === '') {
    return;
}

// CSP nonce registration (Hyva pattern), mirroring seo/json-ld.phtml.
$cspNonce = '';
try {
    $cspBlock = $block->getLayout()->getBlock('hyva.csp');
    if ($cspBlock) {
        $cspNonce = $cspBlock->registerInlineScript();
    }
} catch (\Exception $e) {
    // CSP block not available in this layout context — proceed without nonce
}
?>
<script type="application/ld+json"<?= $cspNonce ? ' nonce="' . /* @noEscape */ $cspNonce . '"' : '' ?>>
<?= /* @noEscape */ $json ?>
</script>
