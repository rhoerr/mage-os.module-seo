{
    "$schema": "vendor/infection/infection/resources/schema.json",
    // Scope mutation testing to unit-tested source. The remaining excludes are
    // classes exercised only by Test/Integration — resource models, schema/meta
    // providers, the llms.txt/llms.jsonl builders and the Organisation repository
    // — which Infection cannot cover because it cannot boot the Magento framework
    // to run those suites locally. Catalog/CurrentEntity is pure Registry
    // delegation. Cron/ is outside the scanned directories entirely.
    "source": {
        "directories": ["Model", "Observer", "Service"],
        "excludes": [
            "ResourceModel",
            "Catalog/CurrentEntity.php",
            "Config/Source/LogoSource.php",
            "Config/Source/OrgType.php",
            "LlmsJsonl/JsonlBuilder.php",
            "LlmsTxt",
            "MetaTag/Provider",
            "Organisation.php",
            "OrganisationRepository.php",
            "StructuredData/Provider/CategorySchemaProvider.php",
            "StructuredData/Provider/CmsPageSchemaProvider.php",
            "StructuredData/Provider/ProductSchemaProvider.php"
        ]
    },
    "mutators": { "@default": true },
    "phpUnit": { "configDir": "." },
    // Baseline thresholds; minMsi sits just below the measured MSI so a
    // regression fails CI. Raise it as coverage of the remaining excluded
    // classes (schema/meta providers, llms builders) grows.
    "minMsi": 54,
    "minCoveredMsi": 70,
    "logs": {
        "text": "infection.log",
        "github": true
    }
}
